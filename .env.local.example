# ==============================================================================
# SKP ASSOCIATION - CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================
# เพื่อให้ระบบส่งอีเมลและไฟล์แนบ (PDF, AutoCAD, Excel, Word, ภาพถ่าย)
# ส่งตรงเข้ากล่องจดหมาย supot.meskp@gmail.com 100% โดยไม่ผ่านตัวกลาง
# ให้คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกข้อมูลด้านล่าง
# ==============================================================================

# 1. Gmail App Password (แนะนำมากที่สุด - สะดวกและปลอดภัย):
# วิธีรับ App Password 16 หลักจาก Google:
# 1) เข้าไปที่ https://myaccount.google.com/security
# 2) เปิดใช้งาน 2-Step Verification (การยืนยันแบบ 2 ขั้นตอน)
# 3) ค้นหา "App Passwords" (รหัสผ่านสำหรับแอป)
# 4) สร้างรหัสผ่านใหม่ เช่น ตั้งชื่อว่า "SKP Website"
# 5) นำรหัสผ่าน 16 ตัวอักษรมาใส่ใน GMAIL_APP_PASSWORD (ไม่ต้องเว้นวรรค)
GMAIL_USER=supot.meskp@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# หรือกำหนดเป็น SMTP ทั่วไป:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=supot.meskp@gmail.com
# SMTP_PASS=your-16-char-app-password
